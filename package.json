{
  "name": "field-inventory",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate --config prisma.global.config.ts && prisma generate --config prisma.catalog.config.ts && prisma generate --config prisma.warehouse.config.ts",
    "db:migrate": "tsx scripts/migrate-warehouses.ts",
    "db:seed": "tsx scripts/seed-dev.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@mantine/core": "^9.7.1",
    "@mantine/hooks": "^9.7.1",
    "@prisma/adapter-libsql": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@tanstack/react-devtools": "0.10.13",
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-query-devtools": "5.104.1",
    "@tanstack/react-router": "1.170.42",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.168.61",
    "jose": "^6.2.12",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@tanstack/devtools-vite": "0.8.5",
    "@tanstack/router-cli": "^1.132.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "fast-check": "^4.10.2",
    "postcss": "^8.5.29",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "prisma": "7.10.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^5.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
