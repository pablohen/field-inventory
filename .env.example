# Global and catalog databases (default: local files under .data/)
GLOBAL_DB_URL=file:.data/global.db
CATALOG_DB_URL=file:.data/catalog.db

# One database per warehouse; {name} is replaced by Warehouse.tursoDbName
WAREHOUSE_DB_URL_TEMPLATE=file:.data/{name}.db

# Turso group auth token (only needed for libsql:// URLs)
# TURSO_GROUP_AUTH_TOKEN=

# Session cookie signing secret
SESSION_SECRET=change-me-to-a-long-random-string

# Turso (production)
TURSO_ORG=
TURSO_PLATFORM_TOKEN=
CATALOG_TURSO_DB=
# WAREHOUSE_DB_URL_TEMPLATE=libsql://{name}-<org>.turso.io
# TURSO_GROUP_AUTH_TOKEN=
